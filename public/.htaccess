# ============================================================
# cps-engenharia.com — Angular SPA (.htaccess deste site)
# ============================================================

# ---------- SPA ROUTING (fallback para index.html) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Arquivos/pastas reais são servidos direto
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outra rota → index.html (o Angular cuida do resto)
  RewriteRule ^ index.html [L]
</IfModule>

# ---------- CACHE (1 ano para assets com hash) ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff  "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # index.html: sempre busca a versão nova (nunca cache longo)
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Assets com hash: cache longo imutável
  <FilesMatch "\.(js|css|webp|png|jpe?g|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---------- Compressão ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
